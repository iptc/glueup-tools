# Glue Up API credentials: copy to .env and fill in. Never commit .env.
# Glue Up gives you these with API access (ask your account manager).

# Public key / account name (e.g. "iptc")
GLUEUP_PUBLIC_KEY=

# Private key (base64). Treat it as a password.
GLUEUP_PRIVATE_KEY=

# Tenant ID (top-level account) and organisation ID (sub-organisation)
GLUEUP_TENANT_ID=
GLUEUP_ORG_ID=

# Optional. Live: https://api-services.glueup.com/v2/  Demo: https://api-demo-story.glueup.com/v2/
GLUEUP_BASE_URL=https://api-services.glueup.com/v2/
